// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "ols": {
      "initialization_options": {
        "enable_hover": true,
        "enable_snippets": true,
        "enable_procedure_snippet": true,
        "enable_completion_matching": true,
        "enable_references": true,
        "enable_document_symbols": true,
        "enable_format": true,
        "enable_document_links": true,
        "collections": [
          {
            "name": "shared",
            "path": "/usr/libexec/Odin/"
          }
        ]
      }
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "executable": "pdflatex",
            "args": ["--shell-escape", "%f"]
          }
        }
      }
    },
    "jdtls": {
      "settings": {
        "java_home": "$HOME/.sdkman/candidates/java/current/",
        "lombok_support": true,
      },
    }
  },
  "disable_ai": false,
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "languages": {
    "Rust": {
      "format_on_save": "off",
    },
  },
  "ui_font_family": "GeistMono Nerd Font",
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "Emacs",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
}
