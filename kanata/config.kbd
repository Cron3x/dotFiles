(defcfg
	process-unmapped-keys yes
	linux-dev (
		"/dev/input/by-path/platform-i8042-serio-0-event-kbd"
		"/dev/input/by-id/usb-Evision_GK630_Gaming_Keyboard-event-kbd"
	)
)

(defvar
	tap-time 200
	hold-time 200
)

(deflocalkeys-linux
  ^    220
)

(defsrc
  ^         1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    z    u    i    o    p    [    ]
  caps      a    s    d    f    g    h    j    k    l    ;    '    \    ret
  lsft <    y    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer base
  _         _    _    _    _    _    _    _    _    _    _    _    _    _
  _         _    _    _    _    _    _    _    _    _    _    _    _
  @caps     _    _    _    _    _    _    _    _    _    @oe  @ae  _    _
  _    @a   _    _    _    _    _    _    _    _    _    _    _
  _    _    @laltxesc      _              _ _ @universal
)

(deflayer universal
  _         _    _    _    _    _    _    _    _    _    _    _    _    _
  _         _    _    _    _    _    _    _    _    _    _    _    _
  @caps     _    _    _    _    _    _    prev pp next   _    _    _    _
  _    _    _    _    _    _    _    (unicode ñ)    _    _    _    _    _
  _    _    _              _              _ _ _
)

(defalias
  caps 		( tap-hold 50 50 esc lctrl )
  universal 	( layer-while-held universal )
  base		( layer-switch base )
	s 			( tap-hold $tap-time $hold-time s lmet )
	d 			( tap-hold $tap-time $hold-time d lalt )
	a 			( tap-hold $tap-time $hold-time < lshift )
	oe			( tap-hold $tap-time $hold-time ; rshift )
	ae			( tap-hold $tap-time $hold-time ' rmet )
	laltxesc	( tap-hold $tap-time $hold-time esc lalt )
)
